<!DOCTYPE html>
<html lang="en">
<head>
  <title>Deep Sea Abyss Exploration</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">

  <style>
    /* Theme: Bioluminescent Abyss (Dark charcoal-blue with vibrant cyan/neon highlights) */
    body { background-color: #0b111e; color: #e2e8f0; }
    .navbar { background-color: #1e293b; border-bottom: 2px solid #06b6d4; }
    .navbar-brand { color: #06b6d4 !important; font-weight: bold; }
    .nav-link { color: #94a3b8 !important; transition: color 0.2s; }
    .nav-link:hover { color: #06b6d4 !important; }
    .section-title { color: #06b6d4; margin: 30px 0 15px; font-weight: 600; }
    .card { background-color: #1e293b; border: 1px solid #334155; color: #f8fafc; }
    .page-link { background-color: #1e293b; border-color: #334155; color: #06b6d4; }
    .page-link:hover { background-color: #06b6d4; color: #0b111e; }
  </style>
</head>

<body>

  <!-- TOPIC 3: NAVIGATION BAR -->
  <nav class="navbar navbar-expand-sm">
    <div class="container">
      <a class="navbar-brand" href="#">Abyss Depth Tracker</a>
      <ul class="navbar-nav ml-auto">
        <li class="nav-item"><a class="nav-link" href="#">Dashboard</a></li>
        <li class="nav-item"><a class="nav-link" href="#">Deep Species</a></li>
        <li class="nav-item"><a class="nav-link" href="#">Oceanic Trenches</a></li>
      </ul>
    </div>
  </nav>

  <div class="container mt-4">

    <!-- TOPIC 2: CARDS -->
    <h4 class="section-title">Mysterious Abyssal Organisms</h4>
    <div class="row">

      <div class="col-md-4 mb-3">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title text-info">Anglerfish</h5>
            <p class="card-text">Equipped with a glowing bioluminescent lure, this deep-sea predator thrives in complete darkness.</p>
            <a href="#" class="btn btn-sm btn-outline-info">Analyze Data</a>
          </div>
        </div>
      </div>

      <div class="col-md-4 mb-3">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title text-warning">Giant Squid</h5>
            <p class="card-text">A massive elusive cephalopod that inhabits extreme depths, featuring the largest eyes in the animal kingdom.</p>
            <a href="#" class="btn btn-sm btn-outline-warning">Analyze Data</a>
          </div>
        </div>
      </div>

      <div class="col-md-4 mb-3">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title text-accent" style="color: #a855f7;">Vampire Squid</h5>
            <p class="card-text">Named for its dark webbed arms, it uses glowing photophores to navigate the oxygen minimum zones.</p>
            <a href="#" class="btn btn-sm btn-outline-primary">Analyze Data</a>
          </div>
        </div>
      </div>

    </div>

    <!-- TOPIC 1: SPINNERS -->
    <h4 class="section-title">Calibrating Sonar Feeds...</h4>
    <div class="d-flex align-items-center mb-4">
      <div class="spinner-grow text-info mr-2" role="status"></div>
      <div class="spinner-grow text-light mr-2" role="status"></div>
      <div class="spinner-grow text-secondary" role="status"></div>
    </div>

    <!-- TOPIC 4: PAGINATION -->
    <h4 class="section-title">Navigate Archives</h4>
    <ul class="pagination">
      <li class="page-item"><a class="page-link" href="#">Back</a></li>
      <li class="page-item active"><a class="page-link" href="#" style="background-color: #06b6d4; border-color: #06b6d4; color: #0b111e;">Zone A</a></li>
      <li class="page-item"><a class="page-link" href="#">Zone B</a></li>
      <li class="page-item"><a class="page-link" href="#">Zone C</a></li>
      <li class="page-item"><a class="page-link" href="#">Forward</a></li>
    </ul>

  </div>

  <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>

</body>
</html>