<!DOCTYPE html>
<html>
  <head>
    <title>Function Parameters Activity</title>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
      <!-- Description about the activity -->
      <p>Learning how JavaScript handles undefined function parameters.</p>

      <!-- The button and the result paragraph -->
      <button onclick="multiply(4)">Click Me!</button>
      <p id="result"></p>
      
      <!-- Internal JavaScript section -->
      <script>
        function multiply(a, b) 
        {
          if (b === undefined) 
          {
            alert("The value of b is undefined");
            b = 5;
          }
          var result = a * b;
          document.getElementById("result").innerHTML = result;
        }
      </script>
  </body>
</html>