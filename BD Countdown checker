<!DOCTYPE html>
<html>
<head>
  <title>My Birthday Countdown Checker</title>

  <style>
    body {
      font-family: 'Poppins', Arial, sans-serif;
      background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%);
      color: #2c3e50;
      text-align: center;
      padding: 20px;
    }

    .birthday-card {
      width: 500px;
      background-color: #ffffff;
      border: 4px solid #4a90e2;
      border-radius: 24px;
      margin: 20px auto;
      padding: 25px;
      box-shadow: 0 10px 25px rgba(74, 144, 226, 0.2);
    }

    h1 {
      color: #2b5c8f;
      font-size: 30px;
      margin-bottom: 10px;
    }

    .emoji {
      font-size: 55px;
    }

    .grid-container {
      display: flex;
      gap: 15px;
      margin-top: 15px;
    }

    .info-box {
      flex: 1;
      background-color: #f0f7ff;
      border: 2px dashed #4a90e2;
      border-radius: 14px;
      padding: 15px;
      text-align: left;
    }

    button {
      background-color: #4a90e2;
      color: white;
      border: none;
      border-radius: 25px;
      padding: 12px 28px;
      font-size: 16px;
      cursor: pointer;
      font-weight: bold;
      transition: background 0.3s ease;
    }

    button:hover {
      background-color: #1e5bb8;
    }

    #daysBox {
      font-size: 48px;
      font-weight: bold;
      color: #3a0ca3;
      margin: 10px 0;
    }

    #result {
      font-size: 14px;
      line-height: 1.6;
    }

    #countdown {
      color: #2b5c8f;
      font-weight: bold;
      line-height: 1.6;
      font-size: 14px;
    }
  </style>
</head>

<body>

  <div class="birthday-card">

    <div class="emoji">🎂🎉</div>

    <h1>My Birthday Countdown Checker</h1>

    <p>
      Click the button below to check how many days are left for the birthday celebration!
    </p>

    <button onclick="checkBirthday()">Check Birthday Countdown</button>

    <h2>Days Left</h2>
    <div id="daysBox">?</div>

    <!-- Restructured into a side-by-side grid layout -->
    <div class="grid-container">
      <div class="info-box">
        <h2>Countdown Review</h2>
        <p id="countdown">Click check to start countdown...</p>
      </div>

      <div class="info-box">
        <h2>Birthday Result</h2>
        <p id="result">Waiting for click...</p>
      </div>
    </div>

  </div>

  <script>
    function checkBirthday() {

      // Null and Undefined
      let birthdayGift = null;
      let birthdayPlan;

      // Block Scope using let and const
      const studentName = "Shahnoor";
      const birthdayMonth = 11; // November
      const birthdayDate = 20;

      let message = "";
      let countdownText = "";

      // The Date Object
      let today = new Date();
      let currentYear = today.getFullYear();

      let birthday = new Date(currentYear, birthdayMonth - 1, birthdayDate);

      // Comparison Operator with if statement
      if (birthday < today) {
        birthday = new Date(currentYear + 1, birthdayMonth - 1, birthdayDate);
      }

      let timeDifference = birthday - today;
      let daysLeft = Math.ceil(timeDifference / (1000 * 60 * 60 * 24));

      // Comparison Operators and if/else Conditional Statements
      if (daysLeft === 0) {
        message = "Happy Birthday, " + studentName + "! Today is your special day!";
      } else if (daysLeft <= 7) {
        message = "Your birthday is almost here, " + studentName + "!";
      } else {
        message = "Keep counting, " + studentName + "! Your birthday is coming soon.";
      }

      // String Concatenation
      let finalMessage = "Student Name: " + studentName + "<br>";
      finalMessage = finalMessage + "Today's Date: " + today.toDateString() + "<br>";
      finalMessage = finalMessage + "Birthday Date: " + birthday.toDateString() + "<br>";
      finalMessage = finalMessage + "Message: " + message + "<br><br>";

      finalMessage = finalMessage + "Birthday Gift: " + birthdayGift + "<br>";
      finalMessage = finalMessage + "Birthday Plan: " + birthdayPlan;

      document.getElementById("daysBox").innerHTML = daysLeft;
      document.getElementById("result").innerHTML = finalMessage;

      // While Loop
      let day = 1;

      while (day <= 5) {
        countdownText = countdownText + "Countdown check " + day;
        countdownText = countdownText + ": Birthday excitement loading...<br>";
        day++;
      }

      document.getElementById("countdown").innerHTML = countdownText;
    }
  </script>

</body>
</html>